# Copy this file to .env and fill in real values. Never commit the real .env file.

# From the Moss dashboard (moss.dev) -> API Keys page
MOSS_PROJECT_ID=your_moss_project_id_here
MOSS_PROJECT_KEY=your_moss_project_key_here

# From platform.openai.com -> API keys. Needs billing enabled on the account.
OPENAI_API_KEY=sk-your_openai_key_here
